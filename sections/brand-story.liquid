{%- liquid
  assign heading = section.settings.heading | default: 'Beautiful Skin Starts With Care'
  assign quote_body = section.settings.quote_body | default: 'Glow Chic is more than skincare. It’s a daily ritual of self-love, confidence, and natural radiance. We believe everyone deserves to feel confident in their own glowing skin, every single day.'
  assign signature = section.settings.signature | default: 'FOUNDER & DERMATOLOGIST, DR. ELEANOR VANE — GLOW CHIC'
-%}

<section class="quote-banner-section">
  <div class="container">
    <div class="quote-banner-card">
      
      <div class="quote-icon-top">
        {% render 'icon-flower' %}
      </div>

      <h2 class="quote-banner-heading">&ldquo;{{ heading }}&rdquo;</h2>

      <p class="quote-banner-body">
        &ldquo;{{ quote_body }}&rdquo;
      </p>

      <span class="quote-banner-signature">
        {{ signature }}
      </span>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Quote Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beautiful Skin Starts With Care"
    },
    {
      "type": "textarea",
      "id": "quote_body",
      "label": "Quote Body",
      "default": "Glow Chic is more than skincare. It’s a daily ritual of self-love, confidence, and natural radiance. We believe everyone deserves to feel confident in their own glowing skin, every single day."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "FOUNDER & DERMATOLOGIST, DR. ELEANOR VANE — GLOW CHIC"
    }
  ],
  "presets": [
    {
      "name": "Brand Quote Banner - Glow Chic"
    }
  ]
}
{% endschema %}
