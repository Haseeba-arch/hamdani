<section class="section-padding" id="about">
  <div class="container">
    <div class="brand-story-grid">
      
      <!-- Left Column: Master Perfumer Atelier Image -->
      <div class="story-image-wrap">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: alt: section.settings.heading }}
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1512290900672-1f55b922a949?auto=format&fit=crop&w=900&q=85" alt="Master Perfumer in Atelier">
        {%- endif -%}
        
        <div class="story-badge">
          <span>&bull; Handcrafted in Small Micro-Batches</span>
        </div>
      </div>

      <!-- Right Column: Story Copy & Signature -->
      <div class="story-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 class="section-title story-title">{{ section.settings.heading }}</h2>

        <p class="story-text">
          {{ section.settings.text_1 | default: 'Born from an obsession with the purest botanical extracts and centuries-old distillation traditions, Ruhe Noor was established to bring back the lost art of true Haute Parfumerie. We believe that true fragrance is not merely an accessory, but an emotional aura.' }}
        </p>

        <p class="story-text">
          {{ section.settings.text_2 | default: 'Each formula is developed without compromise, using rare French Jasmine, wild Damascena Roses, and aged Arabian Ouds aged in our dark cellars for over six months before being hand-poured into heavy crystal flacons.' }}
        </p>

        <div class="story-signature">
          {{ section.settings.signature | default: 'Ruhe Noor Atelier — Master Nose' }}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HERITAGE & VISION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Story of Ruhe Noor"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "Born from an obsession with the purest botanical extracts and centuries-old distillation traditions, Ruhe Noor was established to bring back the lost art of true Haute Parfumerie."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "Each formula is developed without compromise, using rare French Jasmine, wild Damascena Roses, and aged Arabian Ouds aged in our dark cellars for over six months before being hand-poured into heavy crystal flacons."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature Text",
      "default": "Ruhe Noor Atelier — Master Nose"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
