{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✨ OUR PHILOSOPHY'
  assign heading = section.settings.heading | default: 'Designed for Little Moments'
  assign description = section.settings.description | default: "We believe children's clothing should inspire wonder, joy and free movement. Every stitch in our collection is thoughtfully planned to keep little adventurers snug, whether they're exploring the living room carpet or taking their first steps outdoors."
  assign btn_text = section.settings.btn_text | default: 'Discover Our Story'
  assign btn_link = section.settings.btn_link | default: '/pages/about'
  assign image = section.settings.image
-%}

<section class="section-padding brand-story-section" id="story">
  <div class="container">
    <div class="brand-story-grid">
      
      <!-- Left: Image Card with Top Pick Badge -->
      <div class="story-image-wrap">
        <div class="story-image-card">
          <span class="story-top-pick-badge">TOP PICK 2026 ⭐</span>
          {%- if image != blank -%}
            {{ image | image_url: width: 800 | image_tag: alt: 'KIDDO ME Philosophy', class: 'story-img' }}
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=800&q=85" alt="Toddlers playing happily" class="story-img">
          {%- endif -%}
        </div>
      </div>

      <!-- Right: Story Details & Badges -->
      <div class="story-content-wrap">
        <span class="section-eyebrow-pill pill-pink">{{ eyebrow }}</span>
        <h2 class="section-heading-main">{{ heading }}</h2>
        <p class="story-body-text">{{ description }}</p>

        <!-- 3 Feature Badges Row -->
        <div class="story-bullets-row">
          <div class="story-bullet-item">
            <span class="bullet-icon">🌱</span>
            <span class="bullet-text">100% GOTS Certified</span>
          </div>
          <div class="story-bullet-item">
            <span class="bullet-icon">🧸</span>
            <span class="bullet-text">Extra Soft Seams</span>
          </div>
          <div class="story-bullet-item">
            <span class="bullet-icon">⚡</span>
            <span class="bullet-text">Scratch-Free Labels</span>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="story-action-row">
          <a href="{{ btn_link }}" class="btn btn-story-cta">
            <span>{{ btn_text }}</span>
            {% render 'icon-arrow' %}
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story / Philosophy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "✨ OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for Little Moments"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We believe children's clothing should inspire wonder, joy and free movement. Every stitch in our collection is thoughtfully planned to keep little adventurers snug, whether they're exploring the living room carpet or taking their first steps outdoors."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "default": "/pages/about"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    }
  ],
  "presets": [
    {
      "name": "Brand Story / Philosophy"
    }
  ]
}
{% endschema %}
