{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'OUR BEST SELLER COLLECTION'
  assign heading = section.settings.heading | default: 'Discover Your Glow'
  assign subtitle = section.settings.subtitle | default: 'From restorative serums to revitalizing mists, find the perfect addition to your daily skincare routine.'
-%}

<section class="section-padding collection-section" id="collections">
  <div class="container">
    
    <div class="section-header">
      {%- if eyebrow != blank -%}
        <span class="section-eyebrow">{{ eyebrow }}</span>
      {%- endif -%}

      <h2 class="section-title">{{ heading }}</h2>

      {%- if subtitle != blank -%}
        <p class="section-subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Category Filter Tabs -->
    <div class="collection-tabs">
      <button type="button" class="tab-btn active" data-filter="all">ALL PRODUCTS</button>
      <button type="button" class="tab-btn" data-filter="hydration">HYDRATION</button>
      <button type="button" class="tab-btn" data-filter="anti-aging">ANTI-AGING & BRIGHTENING</button>
      <button type="button" class="tab-btn" data-filter="cleansers">CLEANSERS</button>
      <button type="button" class="tab-btn" data-filter="moisturizers">DAILY MOISTURIZERS</button>
    </div>

    <!-- 4-Product Grid -->
    <div class="products-grid-4">
      
      <!-- Card 1: Glow Serum -->
      {% render 'product-card', 
        title: 'Glow Serum', 
        price: '$49.99', 
        compare_price: '$65.00',
        subtitle: 'Deep Hydration Booster', 
        badge: 'BESTSELLER',
        category: 'hydration, anti-aging',
        rating: '4.9 (2.8k)',
        image_url: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=600&q=80'
      %}

      <!-- Card 2: Rose Mist -->
      {% render 'product-card', 
        title: 'Rose Mist', 
        price: '$34.99', 
        compare_price: '$42.00',
        subtitle: 'Refreshing Floral Face Toner', 
        badge: 'NEW',
        category: 'hydration, cleansers',
        rating: '4.8 (950)',
        image_url: 'https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=600&q=80'
      %}

      <!-- Card 3: Hydra Gel Cream -->
      {% render 'product-card', 
        title: 'Hydra Gel Cream', 
        price: '$42.99', 
        compare_price: '$52.00',
        subtitle: '72hr Water Burst Moisturizer', 
        badge: 'POPULAR',
        category: 'hydration, moisturizers',
        rating: '4.9 (1.4k)',
        image_url: 'https://images.unsplash.com/photo-1608248597359-5975005b6378?auto=format&fit=crop&w=600&q=80'
      %}

      <!-- Card 4: Brightening Drops -->
      {% render 'product-card', 
        title: 'Brightening Drops', 
        price: '$38.99', 
        compare_price: '$48.00',
        subtitle: 'Vitamin C Daily Glow Elixir', 
        badge: 'ORGANIC',
        category: 'anti-aging, moisturizers',
        rating: '5.0 (820)',
        image_url: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=600&q=80'
      %}

    </div>

    <!-- Bottom View All Button -->
    <div style="text-align: center;">
      <a href="/collections/all" class="btn btn-outline">
        VIEW ALL PRODUCTS &rarr;
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR BEST SELLER COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Your Glow"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "From restorative serums to revitalizing mists, find the perfect addition to your daily skincare routine."
    }
  ],
  "presets": [
    {
      "name": "Collection Grid - Glow Chic"
    }
  ]
}
{% endschema %}
