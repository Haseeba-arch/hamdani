{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'OUR SIGNATURE RANGES'
  assign heading = section.settings.heading | default: 'Explore Our Collections'
  assign subtitle = section.settings.subtitle | default: 'Find the perfect outfit for every age, season and celebration'
  assign view_all_text = section.settings.view_all_text | default: 'View all categories'
  assign view_all_link = section.settings.view_all_link | default: '/collections'
-%}

<section class="section-padding collection-grid-section" id="collections">
  <div class="container">
    
    <!-- Section Header Row -->
    <div class="section-header-row">
      <div class="section-header-left">
        <span class="section-eyebrow-pill">{{ eyebrow }}</span>
        <h2 class="section-heading-main">{{ heading }}</h2>
        <p class="section-subtitle">{{ subtitle }}</p>
      </div>
      <div class="section-header-right">
        <a href="{{ view_all_link }}" class="link-view-all">
          <span>{{ view_all_text }}</span>
          {% render 'icon-arrow' %}
        </a>
      </div>
    </div>

    <!-- 6 Collections Grid -->
    <div class="collections-cards-grid">
      
      <!-- Card 1 -->
      <div class="collection-item-card">
        <div class="collection-media-box">
          <span class="collection-badge-chip chip-pink">🌸 NEW BORN</span>
          <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=700&q=80" alt="Baby Girl Collection" loading="lazy">
        </div>
        <div class="collection-card-body">
          <h3 class="collection-title">Baby Girl Collection</h3>
          <p class="collection-desc">Sweet dresses, rompers and cute sets for newborn princesses</p>
          <div class="collection-footer-row">
            <span class="collection-count">18+ Products</span>
            <a href="/collections/baby-girl" class="collection-cta-link">
              <span>Shop Now</span>
              {% render 'icon-arrow' %}
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="collection-item-card">
        <div class="collection-media-box">
          <span class="collection-badge-chip chip-yellow">⭐ TODDLER</span>
          <img src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=700&q=80" alt="Toddler Collection" loading="lazy">
        </div>
        <div class="collection-card-body">
          <h3 class="collection-title">Toddler Collection</h3>
          <p class="collection-desc">Trendy and playful streetwear and cosy sets for active kids</p>
          <div class="collection-footer-row">
            <span class="collection-count">24+ Products</span>
            <a href="/collections/toddler" class="collection-cta-link">
              <span>Shop Now</span>
              {% render 'icon-arrow' %}
            </a>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="collection-item-card">
        <div class="collection-media-box">
          <span class="collection-badge-chip chip-mint">🌿 ORGANIC</span>
          <img src="https://images.unsplash.com/photo-1522771930-78848d9293e8?auto=format&fit=crop&w=700&q=80" alt="Boys Collection" loading="lazy">
        </div>
        <div class="collection-card-body">
          <h3 class="collection-title">Boys Collection</h3>
          <p class="collection-desc">Durable t-shirts, joggers and sets for adventurous boys</p>
          <div class="collection-footer-row">
            <span class="collection-count">22+ Products</span>
            <a href="/collections/boys" class="collection-cta-link">
              <span>Shop Now</span>
              {% render 'icon-arrow' %}
            </a>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="collection-item-card">
        <div class="collection-media-box">
          <span class="collection-badge-chip chip-purple">👶 NEW ARRIVALS</span>
          <img src="https://images.unsplash.com/photo-1543332164-6e82f355badc?auto=format&fit=crop&w=700&q=80" alt="Casual Wear" loading="lazy">
        </div>
        <div class="collection-card-body">
          <h3 class="collection-title">Casual Wear</h3>
          <p class="collection-desc">Everyday super-soft cotton tees, shorts and playwear sets</p>
          <div class="collection-footer-row">
            <span class="collection-count">16+ Products</span>
            <a href="/collections/casual" class="collection-cta-link">
              <span>Shop Now</span>
              {% render 'icon-arrow' %}
            </a>
          </div>
        </div>
      </div>

      <!-- Card 5 -->
      <div class="collection-item-card">
        <div class="collection-media-box">
          <span class="collection-badge-chip chip-pink">🎉 PARTY WEAR</span>
          <img src="https://images.unsplash.com/photo-1596870230751-ebdfce98ec42?auto=format&fit=crop&w=700&q=80" alt="Party Wear" loading="lazy">
        </div>
        <div class="collection-card-body">
          <h3 class="collection-title">Party Wear</h3>
          <p class="collection-desc">Glamorous outfits for birthdays, weddings and family events</p>
          <div class="collection-footer-row">
            <span class="collection-count">12+ Products</span>
            <a href="/collections/party" class="collection-cta-link">
              <span>Shop Now</span>
              {% render 'icon-arrow' %}
            </a>
          </div>
        </div>
      </div>

      <!-- Card 6 -->
      <div class="collection-item-card">
        <div class="collection-media-box">
          <span class="collection-badge-chip chip-gold">☀️ SUMMER</span>
          <img src="https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=700&q=80" alt="Sleep & Lounge" loading="lazy">
        </div>
        <div class="collection-card-body">
          <h3 class="collection-title">Sleep & Lounge</h3>
          <p class="collection-desc">Breathable pyjamas and sleepsuits for dreamy night sleeps</p>
          <div class="collection-footer-row">
            <span class="collection-count">14+ Products</span>
            <a href="/collections/sleepwear" class="collection-cta-link">
              <span>Shop Now</span>
              {% render 'icon-arrow' %}
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Explore Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR SIGNATURE RANGES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Explore Our Collections"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Find the perfect outfit for every age, season and celebration"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "View all categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link",
      "default": "/collections"
    }
  ],
  "presets": [
    {
      "name": "Explore Collections"
    }
  ]
}
{% endschema %}
