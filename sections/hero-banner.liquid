{%- liquid
  assign badge_text = section.settings.badge_text | default: '✨ NEW SPRING/SUMMER COLLECTION 2026'
  assign heading_line1 = section.settings.heading_line1 | default: 'Little Styles,'
  assign heading_gradient = section.settings.heading_gradient | default: 'Big Smiles.'
  assign body_text = section.settings.body_text | default: 'Discover delightfully comfortable, stylish and skin-friendly outfits for your little ones. Crafted with love, organic cotton and playful designs that keep kids smiling all day long.'
  assign btn_primary_text = section.settings.btn_primary_text | default: 'SHOP COLLECTION'
  assign btn_primary_link = section.settings.btn_primary_link | default: '#collections'
  assign btn_secondary_text = section.settings.btn_secondary_text | default: 'EXPLORE OFFERS'
  assign btn_secondary_link = section.settings.btn_secondary_link | default: '#featured-products'
  assign hero_image = section.settings.image
  assign trust_1_text = section.settings.trust_1_text | default: 'Free Shipping (Orders over Rs. 3,000)'
  assign trust_2_text = section.settings.trust_2_text | default: '100% Organic Cotton (Safe for sensitive skin)'
  assign floating_badge_text = section.settings.floating_badge_text | default: 'Rated 4.9/5 by 10k+ Mums 💕'
-%}

<section class="hero-banner-section">
  <div class="container">
    <div class="hero-grid">
      
      <!-- Left Content Column -->
      <div class="hero-content-col">
        <!-- Collection Pill Badge -->
        <div class="hero-badge-pill">
          <span>{{ badge_text }}</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-title-main">
          {{ heading_line1 }}<br>
          <span class="hero-text-gradient">{{ heading_gradient }}</span>
        </h1>

        <!-- Body / Subtitle -->
        <p class="hero-body-text">{{ body_text }}</p>

        <!-- CTA Buttons -->
        <div class="hero-actions-row">
          <a href="{{ btn_primary_link }}" class="btn btn-hero-primary">
            <span>{{ btn_primary_text }}</span>
            {% render 'icon-arrow' %}
          </a>
          <a href="{{ btn_secondary_link }}" class="btn btn-hero-secondary">
            <span>{{ btn_secondary_text }}</span>
            <span class="btn-sparkle-icon">✨</span>
          </a>
        </div>

        <!-- Trust Badges Row -->
        <div class="hero-trust-row">
          <div class="hero-trust-item">
            <span class="trust-icon">🚚</span>
            <span class="trust-label">{{ trust_1_text }}</span>
          </div>
          <div class="hero-trust-item">
            <span class="trust-icon">🌿</span>
            <span class="trust-label">{{ trust_2_text }}</span>
          </div>
        </div>
      </div>

      <!-- Right Media Column with Card & Floating Badge -->
      <div class="hero-media-col">
        <div class="hero-image-card">
          <!-- Main Toddler Hero Image -->
          {%- if hero_image != blank -%}
            {{ hero_image | image_url: width: 900 | image_tag: alt: 'KIDDO ME Kids Clothing', class: 'hero-main-img' }}
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=900&q=85" alt="Cute Toddlers in Matching Clothes" class="hero-main-img">
          {%- endif -%}

          <!-- Floating Review Pill Badge -->
          <div class="hero-floating-badge">
            <div class="floating-badge-icon">
              {% render 'icon-bear' %}
            </div>
            <div class="floating-badge-text">
              <span>{{ floating_badge_text }}</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "✨ NEW SPRING/SUMMER COLLECTION 2026"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Headline Line 1",
      "default": "Little Styles,"
    },
    {
      "type": "text",
      "id": "heading_gradient",
      "label": "Headline Gradient Accent",
      "default": "Big Smiles."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Description",
      "default": "Discover delightfully comfortable, stylish and skin-friendly outfits for your little ones. Crafted with love, organic cotton and playful designs that keep kids smiling all day long."
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Text",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Primary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary Button Text",
      "default": "EXPLORE OFFERS"
    },
    {
      "type": "url",
      "id": "btn_secondary_link",
      "label": "Secondary Button Link",
      "default": "/collections"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "trust_1_text",
      "label": "Trust Item 1",
      "default": "Free Shipping (Orders over Rs. 3,000)"
    },
    {
      "type": "text",
      "id": "trust_2_text",
      "label": "Trust Item 2",
      "default": "100% Organic Cotton (Safe for sensitive skin)"
    },
    {
      "type": "text",
      "id": "floating_badge_text",
      "label": "Floating Review Badge Text",
      "default": "Rated 4.9/5 by 10k+ Mums 💕"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner - KIDDO ME"
    }
  ]
}
{% endschema %}
