<section class="section-padding" style="background-color: var(--bg-secondary);">
  <div class="container container-narrow">
    
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h2 class="section-title">{{ section.settings.heading }}</h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="comparison-wrap">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Attribute</th>
            <th class="highlight-col">{{ section.settings.brand_name | default: 'Ruhe Noor' }}</th>
            <th>Traditional Luxury</th>
            <th>Mass Market</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.attribute }}</td>
              <td class="highlight-col">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.luxury_val }}</td>
              <td>{{ block.settings.mass_val }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE ARTISANAL DIFFERENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Ruhe Noor?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A standard-setting comparison between artisanal formulation and mass commercial production."
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Your Brand Name",
      "default": "Ruhe Noor"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "attribute",
          "label": "Attribute Name",
          "default": "Oil Concentration"
        },
        {
          "type": "text",
          "id": "brand_val",
          "label": "Our Brand Value",
          "default": "30%+ Pure Extrait"
        },
        {
          "type": "text",
          "id": "luxury_val",
          "label": "Traditional Luxury Value",
          "default": "12-15% EDP"
        },
        {
          "type": "text",
          "id": "mass_val",
          "label": "Mass Market Value",
          "default": "5-8% EDT"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "attribute": "Fragrance Concentration",
            "brand_val": "30%+ Pure Extrait",
            "luxury_val": "12-15% EDP",
            "mass_val": "5-8% EDT"
          }
        },
        {
          "type": "row",
          "settings": {
            "attribute": "Sillage Longevity",
            "brand_val": "14+ Hours All-Day",
            "luxury_val": "4-6 Hours",
            "mass_val": "1-2 Hours"
          }
        },
        {
          "type": "row",
          "settings": {
            "attribute": "Botanical Sourcing",
            "brand_val": "Pure Harvested Oils",
            "luxury_val": "Partially Synthetic",
            "mass_val": "100% Artificial"
          }
        },
        {
          "type": "row",
          "settings": {
            "attribute": "Micro-Batch Aging",
            "brand_val": "6-Month Cellar Aged",
            "luxury_val": "Rapid Factory Mix",
            "mass_val": "No Maturation"
          }
        },
        {
          "type": "row",
          "settings": {
            "attribute": "Packaging & Flacons",
            "brand_val": "Heavy Polish Crystal",
            "luxury_val": "Standard Glass",
            "mass_val": "Lightweight Molded"
          }
        }
      ]
    }
  ]
}
{% endschema %}
