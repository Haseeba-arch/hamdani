{%- liquid
  assign heading = section.settings.heading | default: 'Why Choose KIDDO ME?'
  assign subtitle = section.settings.subtitle | default: 'See how we compare against traditional babywear brands'
-%}

<section class="section-padding comparison-section" id="comparison">
  <div class="container">
    
    <!-- Section Header Center -->
    <div class="section-header-center">
      <h2 class="section-heading-main">{{ heading }}</h2>
      <p class="section-subtitle">{{ subtitle }}</p>
    </div>

    <!-- Comparison Table Card -->
    <div class="comparison-card">
      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead>
            <tr>
              <th class="col-feature">Features</th>
              <th class="col-brand-highlight">
                <div class="table-brand-header">
                  <span class="table-brand-name">KIDDO ME</span>
                  <span class="table-brand-tag">Our Promise</span>
                </div>
              </th>
              <th class="col-market">Traditional Market Brands</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="feature-name">100% Certified Organic Cotton</td>
              <td class="brand-cell">
                <span class="check-icon">✔</span>
                <span class="cell-highlight-text">Certified GOTS Organic</span>
              </td>
              <td class="market-cell">
                <span class="cross-icon">✖</span>
                <span>Mixed Polyester Blends</span>
              </td>
            </tr>
            <tr>
              <td class="feature-name">Tagless Scratch-Free Design</td>
              <td class="brand-cell">
                <span class="check-icon">✔</span>
                <span class="cell-highlight-text">100% Tagless & Soft</span>
              </td>
              <td class="market-cell">
                <span class="cross-icon">✖</span>
                <span>Scratchy Neck Tags</span>
              </td>
            </tr>
            <tr>
              <td class="feature-name">Nickel-Free Baby Safe Snaps</td>
              <td class="brand-cell">
                <span class="check-icon">✔</span>
                <span class="cell-highlight-text">Premium Hypoallergenic</span>
              </td>
              <td class="market-cell">
                <span class="cross-icon">✖</span>
                <span>Standard Metal Snaps</span>
              </td>
            </tr>
            <tr>
              <td class="feature-name">Natural Non-Toxic Eco Dyes</td>
              <td class="brand-cell">
                <span class="check-icon">✔</span>
                <span class="cell-highlight-text">100% Plant & Baby Safe</span>
              </td>
              <td class="market-cell">
                <span class="cross-icon">✖</span>
                <span>Harsh Chemical Dyes</span>
              </td>
            </tr>
            <tr>
              <td class="feature-name">Pre-Shrunk Long-Lasting Fabric</td>
              <td class="brand-cell">
                <span class="check-icon">✔</span>
                <span class="cell-highlight-text">Holds Size & Softness</span>
              </td>
              <td class="market-cell">
                <span class="cross-icon">✖</span>
                <span>Shrinks After 1st Wash</span>
              </td>
            </tr>
            <tr>
              <td class="feature-name">30-Day Easy Exchange Policy</td>
              <td class="brand-cell">
                <span class="check-icon">✔</span>
                <span class="cell-highlight-text">Hassle-Free 30 Days</span>
              </td>
              <td class="market-cell">
                <span class="cross-icon">✖</span>
                <span>Strict 3-7 Days Only</span>
              </td>
            </tr>
            <tr>
              <td class="feature-name">Free Delivery on Rs. 3,000+</td>
              <td class="brand-cell">
                <span class="check-icon">✔</span>
                <span class="cell-highlight-text">Always Fast & Free</span>
              </td>
              <td class="market-cell">
                <span class="cross-icon">✖</span>
                <span>High Courier Fees</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose KIDDO ME?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "See how we compare against traditional babywear brands"
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}
