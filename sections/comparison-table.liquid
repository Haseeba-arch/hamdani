{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'HONEST COMPARISON'
  assign heading = section.settings.heading | default: 'Why Choose Glow Serum?'
  assign subtitle = section.settings.subtitle | default: 'See how our premium formulation outperforms traditional serums in every category.'
-%}

<section class="section-padding comparison-section" id="comparison">
  <div class="container">
    
    <div class="section-header">
      {%- if eyebrow != blank -%}
        <span class="section-eyebrow">{{ eyebrow }}</span>
      {%- endif -%}

      <h2 class="section-title">{{ heading }}</h2>

      {%- if subtitle != blank -%}
        <p class="section-subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="comparison-table-wrap">
      <table class="comp-table">
        <thead>
          <tr>
            <th>Features</th>
            <th class="brand-col-header">
              <span class="comp-brand-badge">GLOW SERUM</span>
            </th>
            <th style="text-align: center;">Other Brands</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="feature-col">Hyaluronic Acid Matrix</td>
            <td class="brand-col">Multi-Molecular 3D Matrix</td>
            <td class="others-col">Single Molecular Weight</td>
          </tr>
          <tr>
            <td class="feature-col">Deep Hydration</td>
            <td class="brand-col">48 Hours Locked-In</td>
            <td class="others-col">4-6 Hours Surface Only</td>
          </tr>
          <tr>
            <td class="feature-col">100% Clean &amp; Non-Toxic</td>
            <td class="brand-col">✓ Certified Organic Actives</td>
            <td class="others-col">Contains Fillers &amp; Dyes</td>
          </tr>
          <tr>
            <td class="feature-col">Dermatologist Tested</td>
            <td class="brand-col">✓ 98% Proven Clinical Results</td>
            <td class="others-col">Basic Unverified Testing</td>
          </tr>
          <tr>
            <td class="feature-col">Sustainable &amp; Recyclable</td>
            <td class="brand-col">100% Recyclable Glass Flacon</td>
            <td class="others-col">Single-Use Plastic Bottles</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HONEST COMPARISON"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Glow Serum?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "See how our premium formulation outperforms traditional serums in every category."
    }
  ],
  "presets": [
    {
      "name": "Comparison Table - Glow Chic"
    }
  ]
}
{% endschema %}
