{%- liquid
  assign title = section.settings.title | default: 'Glow Serum'
  assign subtitle = section.settings.subtitle | default: 'Multivitamin Radiance Booster Serum 50ml / 1.7 fl. oz.'
  assign category = section.settings.category | default: 'SKINCARE / SERUM / DEEP HYDRATION'
  assign price = section.settings.price | default: '$49.99'
  assign compare_price = section.settings.compare_price | default: '$65.00'
  assign discount_badge = section.settings.discount_badge | default: 'SAVE 23%'
  assign description = section.settings.description | default: 'Revitalize your skin with our antioxidant-rich formula. Designed to deeply penetrate, lock in moisture, brighten skin tone, and restore your natural, youthful radiance without feeling heavy or greasy.'
-%}

<section class="section-padding featured-product-section" id="featured-product">
  <div class="container">
    <div class="featured-product-grid">
      
      <!-- Product Gallery / Image Carousel -->
      <div class="fp-gallery">
        <div class="fp-main-image-wrap">
          <span class="fp-badge-float">BESTSELLER</span>
          <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=900&q=85" 
               class="fp-main-image" 
               alt="{{ title }}">
        </div>

        <!-- Thumbnails Row -->
        <div class="fp-thumbs-row">
          <div class="fp-thumb-item active" data-img-src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=900&q=85">
            <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=200&q=80" alt="Glow Serum Bottle">
          </div>
          <div class="fp-thumb-item" data-img-src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=900&q=85">
            <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=200&q=80" alt="Woman applying serum">
          </div>
          <div class="fp-thumb-item" data-img-src="https://images.unsplash.com/photo-1608248597359-5975005b6378?auto=format&fit=crop&w=900&q=85">
            <img src="https://images.unsplash.com/photo-1608248597359-5975005b6378?auto=format&fit=crop&w=200&q=80" alt="Serum Texture Swatch">
          </div>
        </div>
      </div>

      <!-- Product Information -->
      <div class="fp-info">
        <span class="fp-category">{{ category }}</span>
        <h2 class="fp-title">{{ title }}</h2>
        <p class="fp-subtitle">{{ subtitle }}</p>

        <div class="fp-price-rating-row">
          <span class="fp-price">{{ price }}</span>
          {%- if compare_price != blank -%}
            <span class="fp-compare-price">{{ compare_price }}</span>
          {%- endif -%}
          {%- if discount_badge != blank -%}
            <span class="fp-discount-badge">{{ discount_badge }}</span>
          {%- endif -%}

          <div class="fp-rating-group">
            <div class="star-rating">
              {%- for i in (1..5) -%}
                {% render 'icon-star' %}
              {%- endfor -%}
            </div>
            <span>4.9 (2,840+ Reviews)</span>
          </div>
        </div>

        <p class="fp-description">{{ description }}</p>

        <!-- 2x2 Highlights Grid -->
        <div class="fp-highlights-grid">
          <div class="highlight-pill-item">
            <span class="highlight-check">✓</span>
            <span>Hyaluronic Acid + Vitamin C</span>
          </div>
          <div class="highlight-pill-item">
            <span class="highlight-check">✓</span>
            <span>48hr Deep Hydration</span>
          </div>
          <div class="highlight-pill-item">
            <span class="highlight-check">✓</span>
            <span>Dermatologist Tested</span>
          </div>
          <div class="highlight-pill-item">
            <span class="highlight-check">✓</span>
            <span>Cruelty-Free & Vegan</span>
          </div>
        </div>

        <!-- Quantity & Add to Cart Action -->
        <div class="fp-actions-row">
          <div class="quantity-wrapper">
            <button type="button" class="qty-btn" data-qty-minus aria-label="Decrease quantity">-</button>
            <input type="text" class="qty-input" value="1" readonly>
            <button type="button" class="qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
          </div>

          <button type="button" class="btn btn-primary btn-add-cart-main" data-add-to-cart>
            {% render 'icon-cart' %}
            <span>ADD TO CART &mdash; {{ price }}</span>
          </button>
        </div>

        <!-- 4 Trust Badges -->
        <div class="fp-trust-badges-grid">
          <div class="trust-badge-col">
            {% render 'icon-truck' %}
            <span>Free Express Shipping</span>
          </div>
          <div class="trust-badge-col">
            {% render 'icon-shield' %}
            <span>30-Day Guarantee</span>
          </div>
          <div class="trust-badge-col">
            {% render 'icon-sparkle' %}
            <span>100% Secure Checkout</span>
          </div>
          <div class="trust-badge-col">
            {% render 'icon-flower' %}
            <span>Clean & Organic</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Product",
  "settings": [
    {
      "type": "text",
      "id": "category",
      "label": "Category Eyebrow",
      "default": "SKINCARE / SERUM / DEEP HYDRATION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Product Title",
      "default": "Glow Serum"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Multivitamin Radiance Booster Serum 50ml / 1.7 fl. oz."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$49.99"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "$65.00"
    },
    {
      "type": "text",
      "id": "discount_badge",
      "label": "Discount Badge Text",
      "default": "SAVE 23%"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Revitalize your skin with our antioxidant-rich formula. Designed to deeply penetrate, lock in moisture, brighten skin tone, and restore your natural, youthful radiance without feeling heavy or greasy."
    }
  ],
  "presets": [
    {
      "name": "Featured Product - Glow Serum"
    }
  ]
}
{% endschema %}
