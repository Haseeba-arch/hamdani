{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✨ QUALITY FIRST'
  assign heading = section.settings.heading | default: 'Made With Love & Precision'
  assign subtitle = section.settings.subtitle | default: 'We hold every single garment to the highest safety and comfort standards'
-%}

<section class="section-padding craftsmanship-section">
  <div class="container">
    
    <!-- Section Header Center -->
    <div class="section-header-center">
      <span class="section-eyebrow-pill pill-pink">{{ eyebrow }}</span>
      <h2 class="section-heading-main">{{ heading }}</h2>
      <p class="section-subtitle">{{ subtitle }}</p>
    </div>

    <!-- 4 Progress Bars Container -->
    <div class="stats-progress-card">
      <div class="progress-bars-grid">
        
        <!-- Progress Bar 1 -->
        <div class="progress-item">
          <div class="progress-header">
            <div class="progress-label-wrap">
              <span class="progress-icon">🌿</span>
              <span class="progress-title">Organic & Sustainable Material</span>
            </div>
            <span class="progress-val">100%</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill fill-green" style="width: 100%;"></div>
          </div>
        </div>

        <!-- Progress Bar 2 -->
        <div class="progress-item">
          <div class="progress-header">
            <div class="progress-label-wrap">
              <span class="progress-icon">👶</span>
              <span class="progress-title">Hypoallergenic & Sensitive Skin Safe</span>
            </div>
            <span class="progress-val">99.8%</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill fill-yellow" style="width: 99.8%;"></div>
          </div>
        </div>

        <!-- Progress Bar 3 -->
        <div class="progress-item">
          <div class="progress-header">
            <div class="progress-label-wrap">
              <span class="progress-icon">⭐</span>
              <span class="progress-title">Parent Satisfaction & 5-Star Reviews</span>
            </div>
            <span class="progress-val">98.6%</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill fill-berry" style="width: 98.6%;"></div>
          </div>
        </div>

        <!-- Progress Bar 4 -->
        <div class="progress-item">
          <div class="progress-header">
            <div class="progress-label-wrap">
              <span class="progress-icon">⚡</span>
              <span class="progress-title">Color & Shape Retention (50+ Washes)</span>
            </div>
            <span class="progress-val">97.4%</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill fill-teal" style="width: 97.4%;"></div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Craftsmanship & Stats",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "✨ QUALITY FIRST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made With Love & Precision"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We hold every single garment to the highest safety and comfort standards"
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship & Stats"
    }
  ]
}
{% endschema %}
