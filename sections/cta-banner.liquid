{%- liquid
  assign badge_text = section.settings.badge_text | default: '✨ LIMITED TIME SPRING EDITION'
  assign heading = section.settings.heading | default: 'Made For Little Adventures ✨'
  assign subtitle = section.settings.subtitle | default: 'Get ready for sunny park days, birthday laughs, and cozy bedtime cuddles.'
  assign btn_text = section.settings.btn_text | default: 'Explore Spring Collection'
  assign btn_link = section.settings.btn_link | default: '#collections'
-%}

<section class="section-padding cta-banner-section">
  <div class="container">
    <div class="cta-gradient-card">
      
      <!-- Badge Pill -->
      <div class="cta-badge-pill">
        <span>{{ badge_text }}</span>
      </div>

      <!-- Heading -->
      <h2 class="cta-banner-heading">{{ heading }}</h2>

      <!-- Subtitle -->
      <p class="cta-banner-subtext">{{ subtitle }}</p>

      <!-- CTA Button -->
      <div class="cta-banner-btn-wrap">
        <a href="{{ btn_link }}" class="btn btn-cta-purple">
          <span>{{ btn_text }}</span>
          {% render 'icon-arrow' %}
        </a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Gradient Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "✨ LIMITED TIME SPRING EDITION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made For Little Adventures ✨"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Get ready for sunny park days, birthday laughs, and cozy bedtime cuddles."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Explore Spring Collection"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "CTA Gradient Banner"
    }
  ]
}
{% endschema %}
