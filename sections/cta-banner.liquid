{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'SPECIAL LIMITED TIME OFFER'
  assign heading = section.settings.heading | default: 'Your Glow, Your Ritual, Your Moment.'
  assign text = section.settings.text | default: 'Treat your skin to the luxury it deserves. Enjoy 20% off plus a free rose travel pouch with every order today.'
  assign btn_text = section.settings.btn_text | default: 'SHOP SPECIAL OFFER'
  assign btn_link = section.settings.btn_link | default: '#featured-product'
-%}

<section class="cta-banner-section">
  <div class="container">
    <div class="cta-banner-content">
      
      <div class="badge-pill badge-pill-rose" style="margin-bottom: 18px;">
        {% render 'icon-sparkle' %}
        <span>{{ eyebrow }}</span>
      </div>

      <h2 class="cta-banner-title">{{ heading }}</h2>

      <p class="cta-banner-text">{{ text }}</p>

      <a href="{{ btn_link }}" class="btn btn-primary">
        {{ btn_text }}
      </a>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SPECIAL LIMITED TIME OFFER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Glow, Your Ritual, Your Moment."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Treat your skin to the luxury it deserves. Enjoy 20% off plus a free rose travel pouch with every order today."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP SPECIAL OFFER"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner - Glow Chic"
    }
  ]
}
{% endschema %}
