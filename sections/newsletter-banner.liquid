{%- liquid
  assign heading = section.settings.heading | default: 'Every Little Outfit Tells a Story'
  assign subtitle = section.settings.subtitle | default: 'Join 20,000+ parents who receive our private seasonal drops, exclusive discount codes, and nursery styling guides directly to their inbox.'
  assign placeholder = section.settings.placeholder | default: 'Enter your email address for 15% off...'
  assign button_text = section.settings.button_text | default: 'Subscribe'
-%}

<section class="section-padding newsletter-section">
  <div class="container">
    <div class="newsletter-card-wrap">
      
      <!-- Icon Pin -->
      <div class="newsletter-icon-badge">
        <span class="newsletter-pin-emoji">📍</span>
      </div>

      <!-- Heading -->
      <h2 class="newsletter-title">{{ heading }}</h2>

      <!-- Subtitle -->
      <p class="newsletter-desc">{{ subtitle }}</p>

      <!-- Form -->
      <form class="newsletter-form-row" onsubmit="event.preventDefault(); alert('Thank you for subscribing! Check your inbox for your 15% discount code.');">
        <input type="email" class="newsletter-input" placeholder="{{ placeholder }}" required aria-label="Email Address">
        <button type="submit" class="btn btn-newsletter-submit">
          <span>{{ button_text }}</span>
          {% render 'icon-arrow' %}
        </button>
      </form>

      <!-- Privacy Note -->
      <div class="newsletter-privacy-note">
        <span>🔒 100% privacy. No spam ever, unsubscribe anytime.</span>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Little Outfit Tells a Story"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Join 20,000+ parents who receive our private seasonal drops, exclusive discount codes, and nursery styling guides directly to their inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address for 15% off..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Banner"
    }
  ]
}
{% endschema %}
