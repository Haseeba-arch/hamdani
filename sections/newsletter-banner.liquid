<section class="section-padding">
  <div class="container container-narrow">
    
    <div class="newsletter-card">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h2 class="section-title">{{ section.settings.heading }}</h2>

      <p style="max-width: 580px; margin: 0 auto; color: var(--color-text-muted);">
        {{ section.settings.text }}
      </p>

      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input 
          type="email" 
          name="contact[email]" 
          class="newsletter-input" 
          placeholder="{{ section.settings.placeholder | default: 'Enter your email address...' }}"
          required
        >
        <button type="submit" class="btn btn-dark">
          {{ section.settings.button_text | default: 'Subscribe' }}
        </button>
      {% endform %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRIVATE INVITATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Your Signature Scent"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Join our private salon to receive notifications for micro-batch releases, private events, and complimentary discovery vials."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Banner"
    }
  ]
}
{% endschema %}
