{%- liquid
  assign heading = section.settings.heading | default: 'Join the Glow Club'
  assign subtitle = section.settings.subtitle | default: 'Subscribe for 15% off your first order, exclusive VIP deals, skincare tips, and new product launches.'
  assign placeholder = section.settings.placeholder | default: 'Enter your email address...'
  assign btn_text = section.settings.button_text | default: 'SUBSCRIBE'
-%}

<section class="section-padding newsletter-section">
  <div class="container">
    <div class="newsletter-card">
      
      <div class="quote-icon-top" style="margin-bottom: 16px;">
        {% render 'icon-sparkle' %}
      </div>

      <h2 class="section-title" style="margin-bottom: 10px;">{{ heading }}</h2>
      <p class="section-subtitle" style="max-width: 520px; margin: 0 auto;">{{ subtitle }}</p>

      {% form 'customer', class: 'newsletter-form' %}
        <div class="newsletter-form-row">
          <input type="email" 
                 name="contact[email]" 
                 class="newsletter-input" 
                 placeholder="{{ placeholder }}" 
                 required 
                 aria-label="Email address">
          <button type="submit" class="btn btn-primary">
            {{ btn_text }}
          </button>
        </div>
      {% endform %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Glow Club"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Subscribe for 15% off your first order, exclusive VIP deals, skincare tips, and new product launches."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SUBSCRIBE"
    }
  ],
  "presets": [
    {
      "name": "Newsletter - Glow Chic"
    }
  ]
}
{% endschema %}
