<div class="main-cart-page section-padding">
  <div class="container">
    <div class="cart-page-header">
      <h1 class="section-heading-main">Your Shopping Cart</h1>
    </div>
    <div class="cart-page-content">
      <p>Please use our fast Slide-out Cart Drawer to review items and proceed to checkout.</p>
      <button type="button" class="btn btn-hero-primary" data-cart-drawer-trigger>
        <span>Open Cart Drawer</span>
        {% render 'icon-arrow' %}
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
