<footer class="site-footer">
  <div class="container">
    
    <div class="footer-top-grid">
      
      <!-- Column 1: Brand Bio & Socials -->
      <div>
        <div class="footer-logo">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 200 | image_tag: alt: shop.name }}
          {%- else -%}
            {{ section.settings.brand_title | default: 'Ruhe Noor' }}
          {%- endif -%}
        </div>

        <p class="footer-bio">
          {{ section.settings.bio | default: 'Haute Parfumerie dedicated to the preservation of artisanal micro-batch fragrance creation, pure extracted botanicals, and timeless crystal flacons.' }}
        </p>

        <div class="footer-socials">
          <a href="#" class="social-icon-btn" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" class="social-icon-btn" aria-label="Pinterest">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 12a4 4 0 1 1 8 0c0 2.22-1.78 4-4 4-.83 0-1.54-.3-2.12-.8L9 22"></path></svg>
          </a>
          <a href="#" class="social-icon-btn" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <div>
        <h4 class="footer-col-title">{{ section.settings.menu_1_title | default: 'Explore' }}</h4>
        <ul class="footer-menu">
          <li><a href="/">Home</a></li>
          <li><a href="#featured-product">Featured Extrait</a></li>
          <li><a href="#collections">All Fragrances</a></li>
          <li><a href="#about">Heritage Story</a></li>
          <li><a href="#reviews">Collector Reviews</a></li>
        </ul>
      </div>

      <!-- Column 3: Customer Care -->
      <div>
        <h4 class="footer-col-title">{{ section.settings.menu_2_title | default: 'Customer Care' }}</h4>
        <ul class="footer-menu">
          <li><a href="/pages/shipping">Complimentary Shipping</a></li>
          <li><a href="/pages/returns">Returns & Exchanges</a></li>
          <li><a href="/pages/faq">Frequently Asked Questions</a></li>
          <li><a href="/pages/care">Flacon Care Guide</a></li>
          <li><a href="/pages/privacy">Privacy & Terms</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div>
        <h4 class="footer-col-title">{{ section.settings.newsletter_title | default: 'VIP Concierge' }}</h4>
        <p style="font-size: 0.85rem; color: #A39B94; margin-bottom: 16px;">
          Receive private invitations to preview limited edition flacons and harvest releases.
        </p>

        {% form 'customer', style: 'display: flex; gap: 8px;' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input 
            type="email" 
            name="contact[email]" 
            placeholder="Your email..." 
            required 
            style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 4px; padding: 10px 14px; color: #fff; width: 100%; font-size: 0.85rem;"
          >
          <button type="submit" class="btn btn-primary" style="padding: 10px 18px; font-size: 0.75rem;">
            Join
          </button>
        {% endform %}
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom-bar">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Ruhe Noor Fragrance House' }}. All rights reserved.
      </div>
      <div style="display: flex; gap: 16px; color: #79716B; font-size: 0.8rem;">
        <span>Visa</span>
        <span>Mastercard</span>
        <span>Amex</span>
        <span>Apple Pay</span>
        <span>PayPal</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "Ruhe Noor"
    },
    {
      "type": "textarea",
      "id": "bio",
      "label": "Brand Bio",
      "default": "Haute Parfumerie dedicated to the preservation of artisanal micro-batch fragrance creation, pure extracted botanicals, and timeless crystal flacons."
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Title",
      "default": "Customer Care"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "VIP Concierge"
    }
  ]
}
{% endschema %}
