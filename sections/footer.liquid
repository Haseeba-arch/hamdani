<!-- Pre-Footer Strip -->
<div class="prefooter-strip">
  <div class="container">
    <div class="prefooter-inner">
      <div class="prefooter-text">
        <span>✨</span>
        <span><strong>NEW DAILY SKINCARE ROUTINE IS HERE:</strong> Free worldwide shipping on orders over $50 + 30-day money-back guarantee.</span>
      </div>
      <a href="/collections/all" class="btn btn-primary btn-pill-small">
        SHOP COLLECTION
      </a>
    </div>
  </div>
</div>

<!-- Main Footer -->
<footer class="site-footer">
  <div class="container">
    
    <div class="footer-grid-4">
      
      <!-- Col 1: Brand Info -->
      <div>
        <a href="/" class="header-logo" style="font-size: 1.5rem; margin-bottom: 14px;">
          GLOW <span>CHIC</span>
        </a>
        <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6; max-width: 300px;">
          Empowering your natural glow with clean, dermatologist-formulated botanical skincare crafted for everyday luxury.
        </p>

        <div class="footer-social-row">
          <a href="#" class="footer-social-btn" aria-label="Instagram">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" class="footer-social-btn" aria-label="TikTok">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.81 4.48 6.3 6.3 0 0 0 1.89-4.48V8.71a8.21 8.21 0 0 0 4.89 1.6v-3.62z"/></svg>
          </a>
          <a href="#" class="footer-social-btn" aria-label="Pinterest">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Explore -->
      <div>
        <h4 class="footer-col-title">Explore</h4>
        <ul class="footer-links-list">
          <li><a href="/collections/all" class="footer-link">Shop All</a></li>
          <li><a href="#featured-product" class="footer-link">Glow Serum</a></li>
          <li><a href="#collections" class="footer-link">Rose Mist</a></li>
          <li><a href="#collections" class="footer-link">Hydra Gel Cream</a></li>
          <li><a href="#collections" class="footer-link">Gift Sets</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div>
        <h4 class="footer-col-title">Customer Care</h4>
        <ul class="footer-links-list">
          <li><a href="/pages/contact" class="footer-link">Contact Us</a></li>
          <li><a href="/policies/shipping-policy" class="footer-link">Shipping &amp; Delivery</a></li>
          <li><a href="/policies/refund-policy" class="footer-link">Returns &amp; Guarantee</a></li>
          <li><a href="#faq" class="footer-link">FAQ</a></li>
          <li><a href="/policies/privacy-policy" class="footer-link">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Col 4: Quick Newsletter -->
      <div>
        <h4 class="footer-col-title">Join the Glow Club</h4>
        <p style="font-size: 0.86rem; color: var(--color-text-muted); margin-bottom: 14px;">
          Enjoy 15% off your first order plus exclusive member-only radiance offers.
        </p>
        {% form 'customer', class: 'footer-newsletter-form' %}
          <div style="display: flex; gap: 8px;">
            <input type="email" 
                   name="contact[email]" 
                   class="newsletter-input" 
                   style="padding: 10px 16px; font-size: 0.85rem;" 
                   placeholder="Your email..." 
                   required>
            <button type="submit" class="btn btn-primary" style="padding: 10px 18px; font-size: 0.78rem;">
              JOIN
            </button>
          </div>
        {% endform %}
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom-bar">
      <span>&copy; {{ 'now' | date: '%Y' }} GLOW CHIC. All rights reserved.</span>
      <div class="footer-legal-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/refund-policy">Refund Policy</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "prefooter_text",
      "label": "Pre-Footer Text",
      "default": "NEW DAILY SKINCARE ROUTINE IS HERE: Free worldwide shipping on orders over $50 + 30-day money-back guarantee."
    }
  ]
}
{% endschema %}
