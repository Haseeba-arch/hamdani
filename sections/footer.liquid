<footer class="site-footer" id="contact">
  <div class="container">
    
    <!-- 4 Column Grid -->
    <div class="footer-top-grid">
      
      <!-- Column 1: Brand Info -->
      <div class="footer-col footer-col-brand">
        <a href="/" class="footer-logo">
          <div class="logo-icon-badge">
            {% render 'icon-bear' %}
          </div>
          <div class="logo-text-group">
            <span class="brand-title">KIDDO ME</span>
            <span class="brand-tagline">BABY & TODDLER CLOTHING</span>
          </div>
        </a>
        <p class="footer-bio">
          Premium, organic and ultra-comfortable baby & toddler clothing designed for carefree play and cozy naps.
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer-col">
        <h4 class="footer-col-title">Quick Links</h4>
        <ul class="footer-links-list">
          <li><a href="/">Home</a></li>
          <li><a href="#collections">All Collections</a></li>
          <li><a href="#featured-products">New Arrivals</a></li>
          <li><a href="#featured-product">Best Sellers</a></li>
          <li><a href="#story">About Us</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>

      <!-- Column 3: Customer Care -->
      <div class="footer-col">
        <h4 class="footer-col-title">Customer Care</h4>
        <ul class="footer-links-list">
          <li><a href="#featured-product">Size Guide</a></li>
          <li><a href="#faq">Track Your Order</a></li>
          <li><a href="#faq">Shipping & Returns</a></li>
          <li><a href="#faq">FAQs</a></li>
          <li><a href="/pages/privacy">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Column 4: Social & Follow Us -->
      <div class="footer-col">
        <h4 class="footer-col-title">Follow Us ✨</h4>
        <p class="footer-social-text">Stay updated with our latest drops, parenting tips, and flash offers.</p>
        
        <!-- Social Icons Row -->
        <div class="footer-social-icons">
          <a href="#" class="social-icon-circle" aria-label="Instagram">📸</a>
          <a href="#" class="social-icon-circle" aria-label="Facebook">📘</a>
          <a href="#" class="social-icon-circle" aria-label="TikTok">🎵</a>
          <a href="#" class="social-icon-circle" aria-label="WhatsApp">💬</a>
        </div>

        <!-- Quick Email Form -->
        <form class="footer-quick-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
          <input type="email" placeholder="Your email..." required aria-label="Email">
          <button type="submit" class="footer-quick-btn" aria-label="Submit">➔</button>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <div class="copyright-text">
        &copy; 2026 KIDDO ME Clothing. All rights reserved. Designed with tender love for kids.
      </div>
      <div class="footer-payment-badges">
        <span class="payment-badge">Cash on Delivery</span>
        <span class="payment-badge">Debit / Credit Card</span>
        <span class="payment-badge">EasyPaisa / JazzCash</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
