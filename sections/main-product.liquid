<div class="main-product-page section-padding">
  <div class="container">
    {% render 'product-card',
      title: product.title,
      price: product.price | money,
      compare_price: product.compare_at_price | money,
      discount: '-25%',
      rating: '5.0',
      reviews_count: '148',
      card_badge: 'BESTSELLER',
      card_badge_type: 'badge-purple',
      image_url: product.featured_image | image_url: width: 800
    %}
  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
