<section class="section-padding">
  <div class="container">
    <div class="featured-product-grid">
      
      <div class="fp-gallery">
        <div class="fp-main-image-wrap">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 900 | image_tag: class: 'fp-main-image', alt: product.title }}
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1547887537-6158d64c35b3?auto=format&fit=crop&w=900&q=85" class="fp-main-image" alt="{{ product.title }}">
          {%- endif -%}
        </div>
      </div>

      <div class="fp-info">
        <span class="fp-category">{{ product.type | default: 'EAU DE PARFUM' }}</span>
        <h1 class="fp-title">{{ product.title }}</h1>

        <div class="fp-rating-row">
          <div class="star-rating">
            {%- for i in (1..5) -%}
              {% render 'icon-star' %}
            {%- endfor -%}
          </div>
          <span class="fp-review-count">4.9/5 (128 reviews)</span>
        </div>

        <div class="fp-price-row">
          <span class="fp-price">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="fp-compare-price">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        <div class="fp-description">
          {{ product.description }}
        </div>

        {% form 'product', product, class: 'fp-actions' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <div style="display: flex; gap: 14px; align-items: center;">
            <div class="quantity-wrapper">
              <button type="button" class="qty-btn" data-qty-minus>-</button>
              <input type="number" name="quantity" class="qty-input" value="1" min="1">
              <button type="button" class="qty-btn" data-qty-plus>+</button>
            </div>

            <button type="submit" name="add" class="btn btn-dark" style="flex: 1;" data-add-to-cart>
              Add to Bag &bull; {{ product.price | money }}
            </button>
          </div>

          {{ form | payment_button }}
        {% endform %}

        <div class="fp-trust-badges">
          <div class="trust-badge-item">
            {% render 'icon-truck' %}
            <span>Complimentary Global Shipping</span>
          </div>
          <div class="trust-badge-item">
            {% render 'icon-shield' %}
            <span>100% Authentic Guarantee</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
