{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'SCIENCE MEETS LUXURY'
  assign heading = section.settings.heading | default: 'Feel the Difference'
  assign subtitle = section.settings.subtitle | default: 'A unique formulation designed to deeply penetrate and restore skin barrier function.'
-%}

<section class="section-padding how-it-works-section" id="how-it-works">
  <div class="container">
    
    <div class="section-header">
      {%- if eyebrow != blank -%}
        <span class="section-eyebrow">{{ eyebrow }}</span>
      {%- endif -%}

      <h2 class="section-title">{{ heading }}</h2>

      {%- if subtitle != blank -%}
        <p class="section-subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="steps-3-grid">
      
      <!-- Step 1: Prepare -->
      <div class="step-3-card">
        <div class="step-circle-icon">
          {% render 'icon-flower' %}
        </div>
        <h3 class="step-3-title">Prepare</h3>
        <p class="step-3-desc">Cleanses and gently prepares your skin surface for optimal hydration and bio-active serum absorption.</p>
      </div>

      <!-- Step 2: Revitalize -->
      <div class="step-3-card">
        <div class="step-circle-icon">
          {% render 'icon-sparkle' %}
        </div>
        <h3 class="step-3-title">Revitalize</h3>
        <p class="step-3-desc">Active serum penetrates deep into dermal layers to nourish cells with multi-molecular vitamins and antioxidants.</p>
      </div>

      <!-- Step 3: Radiate -->
      <div class="step-3-card">
        <div class="step-circle-icon">
          {% render 'icon-star' %}
        </div>
        <h3 class="step-3-title">Radiate</h3>
        <p class="step-3-desc">Forms an invisible, breathable moisture seal that locks in all-day luminous, dewy, glass-skin glow.</p>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Feel the Difference",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SCIENCE MEETS LUXURY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feel the Difference"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A unique formulation designed to deeply penetrate and restore skin barrier function."
    }
  ],
  "presets": [
    {
      "name": "Feel the Difference - Glow Chic"
    }
  ]
}
{% endschema %}
