{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'COMMON QUESTIONS & ANSWERS'
  assign heading = section.settings.heading | default: 'Frequently Asked Questions'
  assign subtitle = section.settings.subtitle | default: 'Everything you need to know about our products, ingredients, shipping, and return policies.'
-%}

<section class="section-padding faq-section" id="faq">
  <div class="container">
    
    <div class="section-header">
      {%- if eyebrow != blank -%}
        <span class="section-eyebrow">{{ eyebrow }}</span>
      {%- endif -%}

      <h2 class="section-title">{{ heading }}</h2>

      {%- if subtitle != blank -%}
        <p class="section-subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="faq-accordion-wrap">
      
      <!-- FAQ 1 -->
      <div class="faq-item active">
        <button type="button" class="faq-question-btn" aria-expanded="true">
          <span>What is Glow Serum?</span>
          <svg class="faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="faq-answer-panel" style="max-height: 200px;">
          <p class="faq-answer-text">
            Glow Serum is our award-winning, dermatologist-formulated radiance serum. It combines multi-molecular Hyaluronic Acid, bio-available Vitamin C, Niacinamide, and organic Rose Extract to deeply hydrate, brighten dullness, and strengthen the skin barrier for 48 hours.
          </p>
        </div>
      </div>

      <!-- FAQ 2 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span>How do I use Glow Serum daily?</span>
          <svg class="faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-text">
            Apply 3 to 4 drops onto cleansed, slightly damp facial skin every morning and evening. Gently press and massage upward until fully absorbed before applying your favorite moisturizer or sunscreen.
          </p>
        </div>
      </div>

      <!-- FAQ 3 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span>Can I use this on sensitive skin?</span>
          <svg class="faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-text">
            Yes! Our formulation is 100% hypoallergenic, non-comedogenic, and rigorously dermatologist-tested on sensitive skin panels. It is free from alcohol, parabens, sulfates, and synthetic fragrances.
          </p>
        </div>
      </div>

      <!-- FAQ 4 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span>When should I expect to see results?</span>
          <svg class="faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-text">
            You will experience immediate hydration and a luminous dewy finish from the very first application. Visible improvements in skin tone, reduced dark spots, and smoother texture typically appear within 7 to 14 days of consistent twice-daily use.
          </p>
        </div>
      </div>

      <!-- FAQ 5 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span>Is it cruelty-free and vegan-friendly?</span>
          <svg class="faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-text">
            Absolutely. Glow Chic products are Leaping Bunny certified cruelty-free, 100% vegan, and packaged in fully recyclable glass bottles.
          </p>
        </div>
      </div>

      <!-- FAQ 6 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span>Can I use Glow Serum under makeup or sunscreen?</span>
          <svg class="faq-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="faq-answer-panel">
          <p class="faq-answer-text">
            Yes, our lightweight formula absorbs instantly with zero pilling, making it an extraordinary hydrating primer under SPF, foundation, or tinted moisturizers.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COMMON QUESTIONS & ANSWERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know about our products, ingredients, shipping, and return policies."
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion - Glow Chic"
    }
  ]
}
{% endschema %}
