{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✨ GOT QUESTIONS?'
  assign heading = section.settings.heading | default: 'Frequently Asked Questions'
  assign subtitle = section.settings.subtitle | default: 'Everything you need to know about our products, sizing, and delivery'
-%}

<section class="section-padding faq-section" id="faq">
  <div class="container">
    
    <!-- Section Header Center -->
    <div class="section-header-center">
      <span class="section-eyebrow-pill pill-purple">{{ eyebrow }}</span>
      <h2 class="section-heading-main">{{ heading }}</h2>
      <p class="section-subtitle">{{ subtitle }}</p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="faq-accordion-wrap">
      
      <!-- FAQ 1 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-title">What sizes do you offer for babies and toddlers?</span>
          <span class="faq-chevron">+</span>
        </button>
        <div class="faq-answer-pane">
          <p>We carry sizes starting from newborn (0-3M) up to 24 months (18-24M) and toddler ranges up to 4T. Check our interactive size guide on each product page for exact height and weight measurements.</p>
        </div>
      </div>

      <!-- FAQ 2 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-title">How fast is home delivery across the country?</span>
          <span class="faq-chevron">+</span>
        </button>
        <div class="faq-answer-pane">
          <p>We deliver nationwide in 2 to 4 business days. Major cities (Lahore, Karachi, Islamabad) enjoy fast 48-hour express delivery. Orders above Rs. 3,000 ship 100% free!</p>
        </div>
      </div>

      <!-- FAQ 3 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-title">What materials are used in KIDDO ME clothes?</span>
          <span class="faq-chevron">+</span>
        </button>
        <div class="faq-answer-pane">
          <p>We use 100% GOTS certified combed organic cotton, bamboo-cotton blends, and non-toxic, eco-friendly water-based dyes. All snaps and zippers are hypoallergenic and nickel-free.</p>
        </div>
      </div>

      <!-- FAQ 4 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-title">What is your return and exchange policy?</span>
          <span class="faq-chevron">+</span>
        </button>
        <div class="faq-answer-pane">
          <p>We offer an easy 30-day return and size-exchange guarantee. If the fit isn't perfect, our team will arrange a hassle-free swap right at your doorstep.</p>
        </div>
      </div>

      <!-- FAQ 5 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-title">How do I care for and wash organic cotton garments?</span>
          <span class="faq-chevron">+</span>
        </button>
        <div class="faq-answer-pane">
          <p>Machine wash in cold or lukewarm water (30°C) with mild baby detergent. Tumble dry on low or line dry in the shade to preserve garment softness and colors.</p>
        </div>
      </div>

      <!-- FAQ 6 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-title">Are the snaps and zippers safe for newborn skin?</span>
          <span class="faq-chevron">+</span>
        </button>
        <div class="faq-answer-pane">
          <p>Yes! Every snap button is nickel-free and lead-free. Our zippered outfits feature soft protective cloth guards behind the zipper to prevent any skin irritation or pinching.</p>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "✨ GOT QUESTIONS?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know about our products, sizing, and delivery"
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion"
    }
  ]
}
{% endschema %}
