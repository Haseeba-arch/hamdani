{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✨ REAL REVIEWS'
  assign heading = section.settings.heading | default: 'Why Parents Love KIDDO ME'
  assign subtitle = section.settings.subtitle | default: 'Over 15,000 happy families and counting across the country'
  assign reviews_link_text = section.settings.reviews_link_text | default: 'See All 1,450+ Real Customer Reviews'
  assign reviews_link_url = section.settings.reviews_link_url | default: '#reviews'
-%}

<section class="section-padding testimonials-section" id="reviews">
  <div class="container">
    
    <!-- Section Header Center -->
    <div class="section-header-center">
      <span class="section-eyebrow-pill pill-purple">{{ eyebrow }}</span>
      <h2 class="section-heading-main">{{ heading }}</h2>
      <p class="section-subtitle">{{ subtitle }}</p>
    </div>

    <!-- 4 Testimonials Grid -->
    <div class="testimonials-grid-4">
      
      <!-- Card 1 -->
      <div class="testimonial-card">
        <div class="testimonial-top">
          <div class="testimonial-avatar avatar-pink">
            <span>🌸</span>
          </div>
          <div class="testimonial-stars">
            ★★★★★
          </div>
        </div>
        <h4 class="testimonial-highlight">Superb Quality</h4>
        <p class="testimonial-quote">"My daughter wears this daily and it still looks brand new after dozens of machine washes!"</p>
        <div class="testimonial-author-row">
          <span class="author-name">Ayesha M., Lahore</span>
          <span class="verified-pill">Verified Mum</span>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="testimonial-card">
        <div class="testimonial-top">
          <div class="testimonial-avatar avatar-yellow">
            <span>⭐</span>
          </div>
          <div class="testimonial-stars">
            ★★★★★
          </div>
        </div>
        <h4 class="testimonial-highlight">True to Size & Comfy</h4>
        <p class="testimonial-quote">"The fabric is so soft! No skin redness or rashes. Will definitely order the full summer set."</p>
        <div class="testimonial-author-row">
          <span class="author-name">Fatima K., Karachi</span>
          <span class="verified-pill">Verified Buyer</span>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="testimonial-card">
        <div class="testimonial-top">
          <div class="testimonial-avatar avatar-mint">
            <span>🌿</span>
          </div>
          <div class="testimonial-stars">
            ★★★★★
          </div>
        </div>
        <h4 class="testimonial-highlight">Fast 2-Day Delivery</h4>
        <p class="testimonial-quote">"Ordered on Tuesday, received Wednesday noon. Packaging was beautiful like a luxury gift!"</p>
        <div class="testimonial-author-row">
          <span class="author-name">Zainab R., Islamabad</span>
          <span class="verified-pill">Verified Mum</span>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="testimonial-card">
        <div class="testimonial-top">
          <div class="testimonial-avatar avatar-purple">
            <span>🧸</span>
          </div>
          <div class="testimonial-stars">
            ★★★★★
          </div>
        </div>
        <h4 class="testimonial-highlight">Best Gifting Choice</h4>
        <p class="testimonial-quote">"Gifted this 3-piece set for my nephew's 1st birthday. Parents absolutely loved the softness!"</p>
        <div class="testimonial-author-row">
          <span class="author-name">Mariam S., Rawalpindi</span>
          <span class="verified-pill">Verified Aunt</span>
        </div>
      </div>

    </div>

    <!-- Bottom Link -->
    <div class="testimonials-bottom-link-wrap">
      <a href="{{ reviews_link_url }}" class="link-view-all-reviews">
        <span>{{ reviews_link_text }}</span>
        {% render 'icon-arrow' %}
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Why Parents Love Us",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "✨ REAL REVIEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Parents Love KIDDO ME"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Over 15,000 happy families and counting across the country"
    },
    {
      "type": "text",
      "id": "reviews_link_text",
      "label": "Bottom Link Text",
      "default": "See All 1,450+ Real Customer Reviews"
    },
    {
      "type": "url",
      "id": "reviews_link_url",
      "label": "Bottom Link URL",
      "default": "/pages/reviews"
    }
  ],
  "presets": [
    {
      "name": "Why Parents Love Us"
    }
  ]
}
{% endschema %}
