{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'STEP-BY-STEP BEAUTY ROUTINE'
  assign heading = section.settings.heading | default: 'Your Daily Glow Ritual'
  assign subtitle = section.settings.subtitle | default: 'Crafted to nourish your skin from the inside out with pure active botanical science.'
  assign quote_text = section.settings.quote_text | default: 'Transform your skin in 14 days with our clinically proven 3-step ritual.'
-%}

<section class="section-padding ritual-section" id="ritual">
  <div class="container">
    <div class="ritual-grid">
      
      <!-- Left Media Column with Quote Bubble -->
      <div class="ritual-image-wrap">
        <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=1000&q=85" 
             alt="Glow Chic Skincare Ritual">
        <div class="ritual-quote-float">
          &ldquo;{{ quote_text }}&rdquo;
        </div>
      </div>

      <!-- Right Steps Information Column -->
      <div class="ritual-info">
        <span class="section-eyebrow">{{ eyebrow }}</span>
        <h2 class="section-title">{{ heading }}</h2>
        <p class="section-subtitle">{{ subtitle }}</p>

        <div class="ritual-steps-grid">
          
          <!-- Step 01 -->
          <div class="ritual-step-card">
            <span class="step-num-badge">01</span>
            <h4 class="step-card-title">Brighten & Even Tone</h4>
            <p class="step-card-text">Vitamin C and Niacinamide help fade dark spots, hyperpigmentation, and create an even glowing surface.</p>
          </div>

          <!-- Step 02 -->
          <div class="ritual-step-card">
            <span class="step-num-badge">02</span>
            <h4 class="step-card-title">Deep Hydration</h4>
            <p class="step-card-text">Triple-weight Hyaluronic Acid locks in moisture across all dermal layers for 48 continuous hours.</p>
          </div>

          <!-- Step 03 -->
          <div class="ritual-step-card">
            <span class="step-num-badge">03</span>
            <h4 class="step-card-title">Radiance with Vitamin C</h4>
            <p class="step-card-text">Potent botanical antioxidants fight free radicals, environmental stressors, and skin dullness.</p>
          </div>

          <!-- Step 04 -->
          <div class="ritual-step-card">
            <span class="step-num-badge">04</span>
            <h4 class="step-card-title">Clean & Hypoallergenic</h4>
            <p class="step-card-text">Formulated without harsh chemicals, 100% vegan, cruelty-free, and safe for sensitive skin.</p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Ritual",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STEP-BY-STEP BEAUTY ROUTINE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Daily Glow Ritual"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Crafted to nourish your skin from the inside out with pure active botanical science."
    },
    {
      "type": "text",
      "id": "quote_text",
      "label": "Floating Quote Text",
      "default": "Transform your skin in 14 days with our clinically proven 3-step ritual."
    }
  ],
  "presets": [
    {
      "name": "Brand Ritual - Glow Chic"
    }
  ]
}
{% endschema %}
