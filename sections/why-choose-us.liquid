{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'DESIGNED WITH TENDER LOVE'
  assign heading = section.settings.heading | default: 'Why Choose KIDDO ME?'
  assign subtitle = section.settings.subtitle | default: 'Designed with tender love, perfected for active play.'
-%}

<section class="section-padding why-choose-us-section" id="benefits">
  <div class="container">
    
    <!-- Section Header Center -->
    <div class="section-header-center">
      <span class="section-eyebrow-pill pill-yellow">{{ eyebrow }}</span>
      <h2 class="section-heading-main">{{ heading }}</h2>
      <p class="section-subtitle">{{ subtitle }}</p>
    </div>

    <!-- 8 Benefit Cards Grid -->
    <div class="benefits-grid-8">
      
      <!-- Card 1 (Pink) -->
      <div class="benefit-card card-pink">
        <div class="benefit-icon-wrap">
          <span class="benefit-emoji">🧸</span>
        </div>
        <h3 class="benefit-title">100% Pure Organic Cotton</h3>
        <p class="benefit-text">Chemical-free, hypoallergenic & ultra-soft for sensitive baby skin.</p>
      </div>

      <!-- Card 2 (Yellow) -->
      <div class="benefit-card card-yellow">
        <div class="benefit-icon-wrap">
          <span class="benefit-emoji">📐</span>
        </div>
        <h3 class="benefit-title">Tailored for Growing Tots</h3>
        <p class="benefit-text">Smart stretch fabrics and roomy fits that move as your kid grows.</p>
      </div>

      <!-- Card 3 (Mint) -->
      <div class="benefit-card card-mint">
        <div class="benefit-icon-wrap">
          <span class="benefit-emoji">⚡</span>
        </div>
        <h3 class="benefit-title">Easy Snap & Zip Changing</h3>
        <p class="benefit-text">Stress-free diaper changes with nickel-free snaps & anti-pinch zips.</p>
      </div>

      <!-- Card 4 (Lavender) -->
      <div class="benefit-card card-lavender">
        <div class="benefit-icon-wrap">
          <span class="benefit-emoji">🧺</span>
        </div>
        <h3 class="benefit-title">Durable & Wash Resistant</h3>
        <p class="benefit-text">Retains vibrant colors and softness even after 100+ washes.</p>
      </div>

      <!-- Card 5 (Blue) -->
      <div class="benefit-card card-blue">
        <div class="benefit-icon-wrap">
          <span class="benefit-emoji">🎨</span>
        </div>
        <h3 class="benefit-title">Colour-Fast Dyes</h3>
        <p class="benefit-text">Non-toxic baby-safe eco dyes without harsh aromas or chemicals.</p>
      </div>

      <!-- Card 6 (Coral) -->
      <div class="benefit-card card-coral">
        <div class="benefit-icon-wrap">
          <span class="benefit-emoji">📏</span>
        </div>
        <h3 class="benefit-title">Pre-Shrunk Clothing</h3>
        <p class="benefit-text">What you buy is what stays fitting. No unexpected laundry shrinkage.</p>
      </div>

      <!-- Card 7 (Gold) -->
      <div class="benefit-card card-gold">
        <div class="benefit-icon-wrap">
          <span class="benefit-emoji">🪡</span>
        </div>
        <h3 class="benefit-title">Handmade With Care</h3>
        <p class="benefit-text">Reinforced double stitching on every seam to prevent unravelling.</p>
      </div>

      <!-- Card 8 (Mint Light) -->
      <div class="benefit-card card-mint-light">
        <div class="benefit-icon-wrap">
          <span class="benefit-emoji">🌍</span>
        </div>
        <h3 class="benefit-title">Earth-Friendly Care</h3>
        <p class="benefit-text">Sustainably sourced materials and biodegradable packaging.</p>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us (8 Cards)",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "DESIGNED WITH TENDER LOVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose KIDDO ME?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Designed with tender love, perfected for active play."
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us (8 Cards)"
    }
  ]
}
{% endschema %}
