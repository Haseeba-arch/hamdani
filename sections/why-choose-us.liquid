{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'DESIGNED FOR MAXIMUM RESULTS'
  assign heading = section.settings.heading | default: 'Glow Serum Benefits'
  assign subtitle = section.settings.subtitle | default: 'Formulated with the highest grade active botanicals and vitamins to deliver visible transformation.'
  assign btn_text = section.settings.btn_text | default: 'GET GLOW SERUM NOW'
  assign btn_link = section.settings.btn_link | default: '#featured-product'
-%}

<section class="section-padding benefits-section" id="benefits">
  <div class="container">
    
    <div class="section-header">
      {%- if eyebrow != blank -%}
        <span class="section-eyebrow">{{ eyebrow }}</span>
      {%- endif -%}

      <h2 class="section-title">{{ heading }}</h2>

      {%- if subtitle != blank -%}
        <p class="section-subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="benefits-grid-6">
      
      <!-- Card 1 -->
      <div class="benefit-box">
        <div class="benefit-icon-wrap">
          {% render 'icon-sparkle' %}
        </div>
        <h4 class="benefit-box-title">Deep Cellular Hydration</h4>
        <p class="benefit-box-text">Multi-molecular hyaluronic acid delivers moisture across all 5 layers of the epidermis.</p>
      </div>

      <!-- Card 2 -->
      <div class="benefit-box">
        <div class="benefit-icon-wrap">
          {% render 'icon-flower' %}
        </div>
        <h4 class="benefit-box-title">Vitamin C & Niacinamide</h4>
        <p class="benefit-box-text">Clinically proven actives fade discoloration, even skin tone, and boost natural collagen synthesis.</p>
      </div>

      <!-- Card 3 -->
      <div class="benefit-box">
        <div class="benefit-icon-wrap">
          {% render 'icon-shield' %}
        </div>
        <h4 class="benefit-box-title">Dermatologist Approved</h4>
        <p class="benefit-box-text">Safe and gentle for sensitive, acne-prone, dry, oily, and combination skin types.</p>
      </div>

      <!-- Card 4 -->
      <div class="benefit-box">
        <div class="benefit-icon-wrap">
          {% render 'icon-bottle' %}
        </div>
        <h4 class="benefit-box-title">48hr Moisture Lock Barrier</h4>
        <p class="benefit-box-text">Bio-fermented squalane forms a lightweight breathable shield that locks hydration for 48 hours.</p>
      </div>

      <!-- Card 5 -->
      <div class="benefit-box">
        <div class="benefit-icon-wrap">
          {% render 'icon-truck' %}
        </div>
        <h4 class="benefit-box-title">Non-Greasy & Fast Absorbing</h4>
        <p class="benefit-box-text">Silky featherlight texture melts instantly into pores with zero sticky residue or heavy feeling.</p>
      </div>

      <!-- Card 6 -->
      <div class="benefit-box">
        <div class="benefit-icon-wrap">
          {% render 'icon-star' %}
        </div>
        <h4 class="benefit-box-title">Cruelty-Free & 100% Clean</h4>
        <p class="benefit-box-text">Formulated without parabens, sulfates, synthetic dyes, artificial fragrances, or animal testing.</p>
      </div>

    </div>

    <!-- CTA Button -->
    <div style="text-align: center;">
      <a href="{{ btn_link }}" class="btn btn-primary">
        {{ btn_text }}
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Serum Benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DESIGNED FOR MAXIMUM RESULTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Glow Serum Benefits"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Formulated with the highest grade active botanicals and vitamins to deliver visible transformation."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "GET GLOW SERUM NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Serum Benefits - Glow Chic"
    }
  ]
}
{% endschema %}
