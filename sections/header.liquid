{%- liquid
  assign announcement_text = section.settings.announcement_text | default: 'Free shipping on orders over Rs. 3,000 | 24/7 Customer Support | ✨ 20% OFF FIRST ORDER: KIDDO20'
  assign logo_text = section.settings.logo_text | default: 'KIDDO ME'
  assign logo_tagline = section.settings.logo_tagline | default: 'BABY & TODDLER CLOTHING'
-%}

<div class="header-wrapper" id="siteHeaderWrap">
  <!-- Top Announcement Bar -->
  <div class="announcement-bar">
    <div class="container">
      <div class="announcement-inner">
        <span class="announcement-truck">🚚</span>
        <span class="announcement-content">{{ announcement_text }}</span>
      </div>
    </div>
  </div>

  <!-- Main Site Header -->
  <header class="site-header" id="siteHeader">
    <div class="container">
      <div class="header-inner">
        
        <!-- Brand Logo -->
        <div class="header-brand">
          <a href="/" class="header-logo">
            <div class="logo-icon-badge">
              {% render 'icon-bear' %}
            </div>
            <div class="logo-text-group">
              <span class="brand-title">{{ logo_text }}</span>
              <span class="brand-tagline">{{ logo_tagline }}</span>
            </div>
          </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="header-nav" role="navigation" aria-label="Primary Navigation">
          <a href="/" class="nav-link active">Home</a>
          <a href="#collections" class="nav-link">Collections</a>
          <a href="#featured-products" class="nav-link">New Arrivals</a>
          <a href="#featured-product" class="nav-link">Best Sellers</a>
          <a href="#story" class="nav-link">About Us</a>
          <a href="#contact" class="nav-link">Contact</a>
        </nav>

        <!-- Header Actions (Search, Account, Wishlist, Cart) -->
        <div class="header-actions">
          <!-- Search -->
          <button type="button" class="header-icon-btn" aria-label="Search" data-search-trigger>
            {% render 'icon-search' %}
          </button>

          <!-- Account -->
          <a href="/account" class="header-icon-btn" aria-label="My Account">
            {% render 'icon-user' %}
          </a>

          <!-- Wishlist -->
          <button type="button" class="header-icon-btn wishlist-icon-btn" aria-label="Wishlist" data-wishlist-header>
            {% render 'icon-heart' %}
            <span class="action-count-badge" id="WishlistHeaderCount">0</span>
          </button>

          <!-- Cart Trigger with amount & badge -->
          <button type="button" class="header-cart-btn" data-cart-drawer-trigger aria-label="Open Cart Drawer">
            <div class="cart-icon-wrap">
              {% render 'icon-cart' %}
              <span class="cart-count-badge" id="CartCount">2</span>
            </div>
            <span class="header-cart-price" id="HeaderCartTotal">Rs. 4,798</span>
          </button>

          <!-- Mobile Hamburger Toggle -->
          <button type="button" class="header-icon-btn mobile-menu-toggle" aria-label="Toggle Navigation Menu" id="MobileMenuToggle">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>

      </div>
    </div>
  </header>
</div>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-drawer" id="MobileNavDrawer">
  <div class="mobile-nav-header">
    <div class="logo-text-group">
      <span class="brand-title">{{ logo_text }}</span>
    </div>
    <button type="button" class="mobile-nav-close" id="MobileNavClose">&times;</button>
  </div>
  <nav class="mobile-nav-links">
    <a href="/" class="mobile-nav-link">Home</a>
    <a href="#collections" class="mobile-nav-link">Collections</a>
    <a href="#featured-products" class="mobile-nav-link">New Arrivals</a>
    <a href="#featured-product" class="mobile-nav-link">Best Sellers</a>
    <a href="#story" class="mobile-nav-link">About Us</a>
    <a href="#faq" class="mobile-nav-link">FAQ</a>
    <a href="#contact" class="mobile-nav-link">Contact</a>
  </nav>
</div>

{% schema %}
{
  "name": "Header & Announcement",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Bar Text",
      "default": "Free shipping on orders over Rs. 3,000 | 24/7 Customer Support | ✨ 20% OFF FIRST ORDER: KIDDO20"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Brand Name",
      "default": "KIDDO ME"
    },
    {
      "type": "text",
      "id": "logo_tagline",
      "label": "Logo Tagline",
      "default": "BABY & TODDLER CLOTHING"
    }
  ]
}
{% endschema %}
