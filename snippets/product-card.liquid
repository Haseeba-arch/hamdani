{%- comment -%}
  Renders a product card for collection grids and product carousels
  Accepts:
  - title: {String} Product title
  - price: {String} Product price
  - compare_price: {String} Optional compare price
  - subtitle: {String} Short product description / benefit
  - badge: {String} Badge text (BESTSELLER, NEW, POPULAR, ORGANIC)
  - category: {String} Category identifier for JS filtering
  - image_url: {String} Image URL
  - rating: {String} Rating text (default: '4.9 (1.2k)')
{%- endcomment -%}

<div class="product-card" data-category="{{ category | default: 'all' }}">
  <div class="product-card-media">
    {%- if badge != blank -%}
      <div class="card-badge">
        <span class="badge-pill {% if badge == 'BESTSELLER' %}badge-pill-primary{% elsif badge == 'NEW' %}badge-pill-rose{% elsif badge == 'ORGANIC' %}badge-pill-green{% else %}badge-pill-rose{% endif %}">
          {{ badge }}
        </span>
      </div>
    {%- endif -%}

    <button type="button" class="card-wishlist-btn" aria-label="Add to wishlist">
      {% render 'icon-heart' %}
    </button>

    <img src="{{ image_url | default: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=600&q=80' }}" 
         alt="{{ title | escape }}" 
         loading="lazy">
  </div>

  <div class="product-card-body">
    <div class="card-rating-row">
      <div class="star-rating">
        {%- for i in (1..5) -%}
          {% render 'icon-star' %}
        {%- endfor -%}
      </div>
      <span>{{ rating | default: '4.9 (1.2k)' }}</span>
    </div>

    <h3 class="card-title">{{ title }}</h3>
    <p class="card-subtitle">{{ subtitle | default: 'Radiance & Hydration Booster' }}</p>

    <div class="card-footer-row">
      <div>
        <span class="card-price">{{ price }}</span>
        {%- if compare_price != blank -%}
          <span style="font-size: 0.85rem; color: var(--color-text-light); text-decoration: line-through; margin-left: 6px;">{{ compare_price }}</span>
        {%- endif -%}
      </div>
      <button type="button" class="card-add-btn" data-add-to-cart>
        Add to Cart
      </button>
    </div>
  </div>
</div>
