<div class="cart-drawer-overlay" id="cartDrawerOverlay"></div>

<div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="Your Bag">
  
  <div class="cart-drawer-header">
    <h3 class="cart-drawer-title">Your Bag</h3>
    <button type="button" class="cart-drawer-close" id="cartDrawerClose" aria-label="Close Cart">
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="cart-shipping-meter">
    <p class="meter-text">✨ You're <strong>$10.01</strong> away from <strong>FREE Express Shipping</strong>!</p>
    <div class="meter-track">
      <div class="meter-fill" style="width: 80%;"></div>
    </div>
  </div>

  <div class="cart-drawer-items">
    
    <!-- Item 1: Glow Serum -->
    <div class="cart-drawer-item">
      <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=300&q=80" alt="Glow Serum" class="cart-item-img">
      <div class="cart-item-info">
        <h4 class="cart-item-title">Glow Serum</h4>
        <span class="cart-item-price">$49.99</span>
        <span style="font-size: 0.78rem; color: var(--color-text-muted); margin-bottom: 8px;">Size: 50ml / 1.7 fl. oz.</span>
        <div class="cart-item-bottom">
          <div class="quantity-wrapper" style="height: 36px; padding: 2px;">
            <button type="button" class="qty-btn" data-qty-minus aria-label="Decrease quantity" style="width: 28px; height: 28px; font-size: 0.9rem;">-</button>
            <input type="text" class="qty-input" value="1" readonly style="width: 30px; font-size: 0.85rem;">
            <button type="button" class="qty-btn" data-qty-plus aria-label="Increase quantity" style="width: 28px; height: 28px; font-size: 0.9rem;">+</button>
          </div>
          <button type="button" style="font-size: 0.75rem; color: #B91C1C; text-decoration: underline;">Remove</button>
        </div>
      </div>
    </div>

  </div>

  <div class="cart-drawer-footer">
    <div class="cart-subtotal-row">
      <span>Subtotal</span>
      <span>$49.99</span>
    </div>
    <p style="font-size: 0.78rem; color: var(--color-text-muted); margin-bottom: 16px;">Taxes and shipping calculated at checkout.</p>
    <a href="/checkout" class="btn btn-primary btn-full">
      Proceed to Checkout
    </a>
  </div>

</div>

<!-- Cart Toast -->
<div class="cart-toast" id="cartToast">
  {% render 'icon-check' %}
  <span>Item added to your bag!</span>
</div>
